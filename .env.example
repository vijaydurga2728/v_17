# Copy to .env and fill in. Never commit .env.
V17_TELEGRAM_TOKEN=your_bot_token_here
V17_TELEGRAM_CHAT_ID=your_chat_id_here
V17_STARTING_EQUITY=10000
V17_LOG_LEVEL=INFO
# Override data paths if needed:
# V17_DATA_ROOT=/path/to/data
# V17_DUKASCOPY_CSV_DIR=/path/to/csvs
# MT5 credentials:
# V17_MT5_LOGIN=12345678
# V17_MT5_PASSWORD=your_password
# V17_MT5_SERVER=Broker-Server-Name
